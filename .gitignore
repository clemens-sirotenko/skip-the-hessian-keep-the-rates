# Publish only the standalone experiment code and its dependencies.
# Everything else remains available locally but is excluded from Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/THIRD_PARTY.txt
!/MF/
!/NN/
!/SVM/

/MF/*
!/MF/experiment_matrix_factorization_multiple_parallel_final.ipynb
!/MF/methods.py
!/MF/oracles.py
!/MF/oracles_mat_fac.py
!/MF/cubic_glrt.py
!/MF/utils.py
!/MF/utils_new.py
!/MF/representative_plots.py
!/MF/experiment_results.py
!/MF/requirements-glrt.txt

/NN/*
!/NN/experiment_nn_lipschitz_constraint_new.ipynb
!/NN/GLAdSSNOptimizer_new.py
!/NN/utils_new.py

/SVM/*
!/SVM/experiment_SVM_new.ipynb
!/SVM/SVM_oracles_new.py
!/SVM/SVM_utils_new.py
